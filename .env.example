# SECOPPAL — variables de entorno
# Copia este archivo a `.env` y rellena tus valores:  cp .env.example .env
# El `.env` está en .gitignore (no se sube al repo).

# ── Autenticación de la UI ───────────────────────────────────────────────────
# Admin inicial (solo se usa en el PRIMER arranque para crear tu cuenta admin).
# Tras el primer login, cambia la contraseña desde el panel y puedes borrar/rotar
# estas variables. Si ya existe algún admin, estas variables se ignoran.
SECOPPAL_ADMIN_EMAIL=tu@correo.com
SECOPPAL_ADMIN_PASSWORD=cambia-esto-por-algo-fuerte
SECOPPAL_ADMIN_NAME=Tu Nombre
# Pon en false SOLO para desarrollo/tests (desactiva el login por completo).
SECOPPAL_AUTH_ENABLED=true

# ── SECOP / datos.gov.co (Socrata) ───────────────────────────────────────────
SECOP_APP_TOKEN=
SECOP_API_KEY_ID=
SECOP_APP_SECRET=

# Transporte Socrata. Default productivo: soda3.
# Rollback explícito: SECOPPAL_SOCRATA_TRANSPORT=classic
# Cualquier otro valor aborta el arranque en vez de elegir uno por ti.
SECOPPAL_SOCRATA_TRANSPORT=soda3

# ── LLM (DeepSeek) — opcional ─────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ── Base de datos (SQLite) ────────────────────────────────────────────────────
# Por defecto data/secoppal.db; cámbialo solo si quieres otra ruta.
# SECOP_FEEDBACK_DB_PATH=data/secoppal.db
# SECOP_ACTOR_ALIAS_INDEX_PATH=data/actor_alias_index.sqlite

# ── Actor Profile ─────────────────────────────────────────────────────────────
# Encendido por defecto, también en el código (app/config.py), como capacidad
# productiva del beta. Configura false únicamente como rollback explícito.
#
# El índice de aliases de actores completo y de esquema compatible sigue siendo
# requisito operativo en SECOP_ACTOR_ALIAS_INDEX_PATH (ver arriba); sin artefacto
# válido el resolver devuelve INDEX_UNAVAILABLE y no adivina identidades.
# El SQLite se construye con scripts/build_actor_alias_index.py y está ignorado
# por git: no se commitea.
#
# Guía: docs/architecture/ACTOR_PROFILE_V1.md · decisión: ADR-060
SECOPPAL_ACTOR_PROFILE_ENABLED=true
