  "limited_guarantees": [
   {
    "closed_by": "M2A-3 properties that call check_transition over GENERATED bases with every field filled, a dual anchor and a view (the oracle invents no content in the Gold's bases)",
    "id": "LG-BASES-WITHOUT-HOST-FIELDS",
    "kind": "ORACLE_BLIND_SPOT",
    "what": "on the Gold's own bases policies, receipt_rules and provenance.{source_amount, year, year_source, buyer_scope, inherited_from} are empty (the Gold carries none), so rebuilding a carried condition with those defaults is invisible there"
   },
   {
    "closed_by": "M2A-3 passes its own subject-to-dataset table as dataset_of",
    "id": "LG-DATASET-VALUE",
    "kind": "ORACLE_BLIND_SPOT",
    "what": "the value of a redirected request's dataset is the host table's: without ``dataset_of`` the check is relational (never the old one, never another subject's)"
   },
   {
    "closed_by": "the authorities' own gates (E-*/F)",
    "id": "LG-REQUEST-POLICIES",
    "kind": "ORACLE_BLIND_SPOT",
    "what": "which policies the host re-decides on the composed effective (§6.6) is not determined by the Gold or the contract text: any well-formed policy list over the effective's conditions passes"
   },
   {
    "closed_by": "M2A-1b / M2A-6",
    "id": "LG-FRESH-ACCEPTANCE",
    "kind": "ORACLE_BLIND_SPOT",
    "what": "the effective of a NEW_SEARCH is built by from_acceptance (M2A-1b), not the reducer: only its meaning is compared and ``audit`` reports it as unverified when it is not supplied; no transition is checked"
   },
   {
    "closed_by": "M2A-8b",
    "id": "LG-CLASSIFICATION-CERTIFIED-BY-8B",
    "kind": "SCOPE",
    "what": "the §20.2 gate «búsqueda nueva y delta confundidos» is certified by M2A-8b with the real producer, not by this oracle: it measures the §7.2 scope only where the facts of P determine it UNIQUELY, reads the absence of every continuation marker as «no evidence» (closed world over the labels) and cannot see the «verb of request» that makes a frame, so every lone content condition is NO_MEDIBLE for classification"
   },
   {
    "closed_by": "check_transition T-COND-REMOVAL on any input that exercises it (killed by f16_any_value)",
    "id": "GOLD-GAP-F16-ANY-VALUE",
    "kind": "GOLD_GAP",
    "what": "a reducer that inverts the polarity of the single positive of a slot whatever the value of the negative SET is not discriminated by the Gold: no applicable case sets a negative of another value over a single positive"
   },
   {
    "closed_by": "check_transition T-COND-REMOVAL (killed by set_clears_whole_dimension)",
    "id": "GOLD-GAP-SET-CLEARS-WHOLE-DIMENSION",
    "kind": "GOLD_GAP",
    "what": "a reducer whose SET of one polarity removes the other polarity of the dimension is not discriminated by the Gold: no applicable case carries both polarities of a dimension through a SET"
   },
   {
    "closed_by": "check_transition T-COND-WRITTEN-SLOT (killed by clear_dimension_only_positive)",
    "id": "GOLD-GAP-CLEAR-DIMENSION-ONLY-POSITIVE",
    "kind": "GOLD_GAP",
    "what": "a reducer whose CLEAR of a dimension leaves its negative conditions is not discriminated by the Gold: no applicable case clears a dimension that holds a negative condition"
   },
   {
    "closed_by": "D-BUYER (buyer.territory) and a Gold case that executes a compatible territory over a carried buyer",
    "id": "GOLD-GAP-H6-OVERFIRE",
    "kind": "GOLD_GAP",
    "what": "a reducer that over-fires H6 (a clarification for any new territory next to a buyer) is not discriminated: no applicable EXECUTE case has a territory next to a carried buyer (the H6 cases, SF123 and SF155, are the D-BUYER and E-GEO lanes')"
   },
   {
    "closed_by": "check_transition T-REQ-TARGET (killed by redirect_keeps_old_kind)",
    "id": "GOLD-GAP-REPLACE-UNIVERSE-KEEPS-OLD-KIND",
    "kind": "GOLD_GAP",
    "what": "a reducer that keeps the old universe kind after REPLACE_UNIVERSE is not discriminated by the Gold: no applicable case changes the kind (SF075, records to opportunities, is declared dependent downstream)"
   }
