    },
    "SUPPLIER_GROUP": {
      "attributes": [
        "active",
        "creation_date",
        "PLATFORM_SUPPLIER_CODE",
        "platform_reference_evidence"
      ],
      "authority": "ceth-n4bn:codigo_grupo",
